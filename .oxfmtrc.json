{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "overrides": [
    {
      "files": ["*.html"],
      "options": {
        "singleQuote": false
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "distS3/**",
    "coverage/**",
    "tmp/**",
    ".angular/**",
    ".nx/**",
    ".cursor/**",
    ".gemini/**",
    ".junie/**",
    "CHANGELOG.md",
    "**/*__template__"
  ]
}
