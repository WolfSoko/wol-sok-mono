{
  "name": "tools",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools",
  "projectType": "application",
  "tags": ["tools"],
  "targets": {
    "typecheck-tools": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/**/*.ts",
        "{workspaceRoot}/tools/tsconfig.tools.json",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "options": {
        "command": "tsc -p tools/tsconfig.tools.json --noEmit"
      }
    }
  }
}
