{
  "name": "oxlint-workspace-rules",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/oxlint",
  "projectType": "library",
  "tags": ["tools"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        {
          "externalDependencies": ["oxlint"]
        }
      ],
      "options": {
        "command": "node --test tools/oxlint/workspace-rules.spec.mjs"
      }
    }
  }
}
