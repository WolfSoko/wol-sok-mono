{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "jsPlugins": [
    "@nx/oxlint/boundaries-plugin",
    "./tools/oxlint/workspace-rules.mjs"
  ],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "dist/**",
    "distS3/**",
    "coverage/**",
    "tmp/**",
    "out-tsc/**",
    ".angular/**",
    ".nx/**",
    "cdk.out/**",
    "storybook-static/**",
    "**/test-build-path/**",
    "**/*__template__",
    "**/vite.config.*.timestamp*",
    "**/vitest.config.*.timestamp*"
  ],
  "rules": {
    "no-unused-vars": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-empty-object-type": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/no-namespace": "error",
    "typescript/no-this-alias": "error",
    "typescript/prefer-as-const": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": "allow-with-description",
        "ts-nocheck": "allow-with-description",
        "ts-check": false
      }
    ],
    "@nx/enforce-module-boundaries": [
      "error",
      {
        "allow": [],
        "depConstraints": [
          {
            "sourceTag": "app",
            "onlyDependOnLibsWithTags": [
              "shared",
              "utils",
              "feature",
              "feature:lazy",
              "feature:admin",
              "feat-shared",
              "api",
              "type:remote"
            ]
          },
          {
            "sourceTag": "tools",
            "onlyDependOnLibsWithTags": [
              "feat-shared",
              "shared",
              "utils",
              "tools"
            ]
          },
          {
            "sourceTag": "infra",
            "onlyDependOnLibsWithTags": ["infra-shared"]
          },
          {
            "sourceTag": "infra-shared",
            "onlyDependOnLibsWithTags": ["infra-shared"]
          },
          {
            "sourceTag": "e2e",
            "onlyDependOnLibsWithTags": ["shared"]
          },
          {
            "sourceTag": "feature",
            "onlyDependOnLibsWithTags": [
              "feat-shared",
              "shared",
              "utils",
              "api"
            ]
          },
          {
            "sourceTag": "feature:lazy",
            "onlyDependOnLibsWithTags": [
              "feat-shared",
              "shared",
              "utils",
              "api"
            ]
          },
          {
            "sourceTag": "feature:admin",
            "onlyDependOnLibsWithTags": [
              "feature:lazy",
              "feat-shared",
              "shared",
              "utils",
              "api"
            ]
          },
          {
            "sourceTag": "feat-shared",
            "onlyDependOnLibsWithTags": ["shared", "utils", "api"]
          },
          {
            "sourceTag": "shared",
            "onlyDependOnLibsWithTags": ["shared", "utils", "api"]
          },
          {
            "sourceTag": "utils",
            "onlyDependOnLibsWithTags": ["utils"]
          },
          {
            "sourceTag": "api",
            "onlyDependOnLibsWithTags": ["api"]
          }
        ]
      }
    ],
    "wolsok/no-boundary-disable": "error",
    "wolsok/no-version-json-read": "error",
    "unicorn/no-new-array": "off",
    "typescript/unbound-method": [
      "error",
      {
        "ignoreStatic": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "apps/{angular-examples,*-remote,*-cdk,nx-aws-cdk-v2-e2e,ws-thanos-test-app}/**/*.spec.ts",
        "libs/**/*.spec.ts",
        "tools/**/*.spec.ts"
      ],
      "plugins": ["jest"],
      "env": {
        "jest": true
      },
      "rules": {
        "jest/expect-expect": "off",
        "jest/require-to-throw-message": "off",
        "jest/no-disabled-tests": "warn",
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["apps/{korbjaeger,pacetrainer,rollapolla-analog}/**/*.spec.ts"],
      "plugins": ["vitest"],
      "env": {
        "vitest": true
      },
      "rules": {
        "vitest/expect-expect": "off",
        "vitest/require-to-throw-message": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/no-disabled-tests": "warn",
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["libs/features/bacteria-engine/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@angular/*",
                  "@ngrx/*",
                  "rxjs",
                  "rxjs/*",
                  "firebase",
                  "firebase/*",
                  "**/arena/*",
                  "**/gl/*",
                  "**/sound/*"
                ],
                "message": "The game's engine (feat-shared-bacteria-engine) runs in Node too (ADR 0011): no Angular, NgRx, RxJS, Firebase, arena/, gl/ or sound/ imports."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/features/basketball-data/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@angular/*",
                  "@ngrx/*",
                  "rxjs",
                  "rxjs/*",
                  "firebase",
                  "firebase/*",
                  "firebase-admin",
                  "firebase-admin/*"
                ],
                "message": "The basketball data lib (feat-shared-basketball-data) runs in the app's server routes too (ADR 0018): no Angular, NgRx, RxJS or Firebase imports."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "libs/features/lazy/bacteria-game/src/watch.ts",
        "libs/features/lazy/bacteria-game/src/lib/replays/{watch-page.component,public-replays,replay-viewer.component,replay-scene}.ts",
        "libs/features/lazy/bacteria-game/src/lib/storage/public-replays.ts",
        "libs/features/lazy/bacteria-game/src/lib/arena/arena-content.ts",
        "libs/features/lazy/bacteria-game/src/lib/fullscreen.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "firebase",
                  "firebase/*",
                  "@angular/fire",
                  "@angular/fire/*",
                  "**/storage/*",
                  "!**/storage/public-replays",
                  "**/net/*",
                  "**/menu/*",
                  "**/bacteria-game.component",
                  "**/state/game-state.service",
                  "**/settings.service",
                  "**/evolution.service"
                ],
                "message": "The watch entry (watch.ts, ADR 0011) loads without the stage, the storage backends or Firebase: it reaches a public replay through loadPublicReplay only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["libs/utils/version/**"],
      "rules": {
        "wolsok/no-version-json-read": "off"
      }
    },
    {
      "files": ["libs/utils/version/src/version.ts"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "allow": ["^\\.\\./\\.\\./\\.\\./\\.\\./version\\.json$"],
            "depConstraints": [
              {
                "sourceTag": "utils",
                "onlyDependOnLibsWithTags": ["utils"]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/*/vite.config.ts"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "allow": ["^\\.\\./\\.\\./tools/vite/nitro-ts-path-aliases$"],
            "depConstraints": [
              {
                "sourceTag": "*",
                "onlyDependOnLibsWithTags": []
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tools/bacteria-game/balance/**", "tools/korbjaeger/**"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "allow": [
              "^(\\.\\./)+libs/features/(bacteria-engine|basketball-data)/src/"
            ],
            "depConstraints": [
              {
                "sourceTag": "tools",
                "onlyDependOnLibsWithTags": [
                  "feat-shared",
                  "shared",
                  "utils",
                  "tools"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/*/federation.config.js"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "allow": ["^\\.\\./\\.\\./tools/federation/workspace-federation$"],
            "depConstraints": [
              {
                "sourceTag": "*",
                "onlyDependOnLibsWithTags": []
              }
            ]
          }
        ]
      }
    }
  ]
}
