{
  "name": "korbjaeger",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "{projectRoot}/src",
  "tags": ["app", "type:firebase"],
  "targets": {
    "build-app": {
      "executor": "@analogjs/platform:vite",
      "dependsOn": ["^build"],
      "inputs": ["sharedGlobals", "production", "^production"],
      "cache": true,
      "defaultConfiguration": "production",
      "options": {
        "main": "{projectRoot}/src/main.ts",
        "configFile": "{projectRoot}/vite.config.ts",
        "outputPath": "{workspaceRoot}/dist/{projectRoot}/client",
        "tsConfig": "{projectRoot}/tsconfig.app.json"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "e2e": {
          "mode": "e2e"
        },
        "production": {
          "sourcemap": true,
          "mode": "production"
        }
      },
      "outputs": [
        "{options.outputPath}",
        "{workspaceRoot}/dist/{projectRoot}/.nitro",
        "{workspaceRoot}/dist/{projectRoot}/analog"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-app"],
      "cache": false,
      "defaultConfiguration": "production",
      "options": {
        "commands": [
          "cp node_modules/@angular/service-worker/ngsw-worker.js node_modules/@angular/service-worker/safety-worker.js dist/apps/korbjaeger/analog/public/",
          "ngsw-config dist/apps/korbjaeger/analog/public apps/korbjaeger/ngsw-config.json /"
        ],
        "parallel": false
      },
      "configurations": {
        "production": {},
        "development": {},
        "e2e": {}
      }
    },
    "serve": {
      "executor": "@analogjs/platform:vite-dev-server",
      "defaultConfiguration": "development",
      "continuous": true,
      "options": {
        "buildTarget": "korbjaeger:build-app",
        "port": 4302
      },
      "configurations": {
        "development": {
          "buildTarget": "korbjaeger:build-app:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "korbjaeger:build-app:production"
        }
      }
    },
    "serve-e2e": {
      "executor": "@analogjs/platform:vite-dev-server",
      "continuous": true,
      "options": {
        "buildTarget": "korbjaeger:build-app:e2e",
        "port": 4304
      }
    },
    "fake-dbb": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "tsx --tsconfig tsconfig.base.json apps/korbjaeger/e2e/fake-dbb/server.cts",
        "cwd": "{workspaceRoot}"
      }
    },
    "icons": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx ./tools/korbjaeger/generate-icons.ts"
      }
    },
    "test": {
      "executor": "@analogjs/vitest-angular:test",
      "options": {
        "configFile": "vite.config.ts"
      }
    },
    "firebase": {
      "executor": "nx:run-commands",
      "options": {
        "command": "firebase --config=firebase.korbjaeger.json --project=korbjaeger"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/firebase.korbjaeger.json",
        "{workspaceRoot}/.firebaserc"
      ],
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "nx run korbjaeger:firebase functions:artifacts:setpolicy --location=europe-central2 --days=1 --force",
          "nx run korbjaeger:firebase deploy"
        ],
        "parallel": false
      }
    },
    "typecheck-specs": {},
    "test-emulator": {
      "executor": "nx:run-commands",
      "options": {
        "command": "firebase emulators:exec --config apps/korbjaeger/emulator/firebase.test.json --project demo-korbjaeger --only firestore \"npx vitest run --config apps/korbjaeger/vite.emulator.config.ts\""
      }
    },
    "emulatoren": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "firebase emulators:start --config apps/korbjaeger/firebase.emulatoren.json --project demo-korbjaeger --only auth,firestore"
      }
    }
  }
}
