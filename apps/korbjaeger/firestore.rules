rules_version = '2';

// The Firestore rules of Korbjäger (ADR 0019): one document per signed-in
// Elternteil, selections/{uid}, holding Meine Teams and the Kinder as maps
// keyed by their DBB id (a Team: since when it is followed; a Kind: since
// when it is marked, and an optional Spitzname), the Vereinsfarben by the
// Verein's DBB id (a colour and an optional second one, as one text), nothing
// else and only theirs. Keyed by id, every change is a write of its own
// entries, which the server merges with other devices' (auswahl-dokument.ts).
// The collection names are those of @wolsok/feat-korbjaeger-collections.
// Specs: src/firestore-rules.emulator.ts (`nx run korbjaeger:test-emulator`).
//
// A request may evaluate at most 1000 expressions, and each read of a map
// through a function counts again: 50 Teams, 20 Kinder and the colours of
// 50 Vereine are more than one request can check. So a create checks the
// maps it holds, an update only the maps it changes, and the app changes one
// map a write (the merge at sign-in in one step a map): each holds up to its
// cap.
service cloud.firestore {
  match /databases/{database}/documents {
    // The owner, unless their account was deleted: the Auth deletion's
    // trigger (korbjaeger-functions, `kontoGeloescht`) writes
    // deletedAccounts/{uid} before it deletes selections/{uid}, as another
    // device's token stays valid for up to an hour. The tombstone is closed to
    // clients (no rule matches it) and expires after a day (TTL on
    // `expireAt`, firestore.indexes.json), longer than any token lives.
    // geloeschteKonten/{uid} holds the tombstones written before #2966, until
    // they expired.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/deletedAccounts/$(uid))
        && !exists(/databases/$(database)/documents/geloeschteKonten/$(uid));
    }

    // The selection of versions 1 and 2, with German fields: the app moves it
    // into selections/{uid} when the account is opened, then deletes it
    // (legacy-account-migration.ts, #2966). No app writes it any more.
    match /auswahl/{uid} {
      allow get, delete: if isOwner(uid);
    }

    match /selections/{uid} {
      allow get, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && isVersion3(request.resource.data)
        && (!("teams" in request.resource.data)
          || areTeams(request.resource.data.teams))
        && (!("children" in request.resource.data)
          || areChildren(request.resource.data.children))
        && (!("clubColors" in request.resource.data)
          || areClubColors(request.resource.data.clubColors));
      // an update is checked in the maps it changes only; one that only
      // loses entries is taken as it is, so a map over its cap shrinks
      allow update: if isOwner(uid)
        && isVersion3(request.resource.data)
        && (!("teams" in request.resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["teams"])
          || onlyFewer(request.resource.data.teams, resource.data.teams)
          || areTeams(request.resource.data.teams))
        && (!("children" in request.resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["children"])
          || onlyFewer(request.resource.data.children, resource.data.children)
          || areChildren(request.resource.data.children))
        && (!("clubColors" in request.resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["clubColors"])
          || onlyFewer(request.resource.data.clubColors, resource.data.clubColors)
          || areClubColors(request.resource.data.clubColors));
    }
  }

  // Version 3 of the app's AuswahlDokument (auswahl-dokument.ts: the maps
  // keyed by id, the fields in English since #2966), with no other fields; a
  // newer version changes these rules in the same release. The maps are
  // checked in the rules above, not through a function of the document:
  // every read through one more argument counts again.
  function isVersion3(data) {
    return data.keys().hasOnly(["version", "teams", "children", "clubColors"])
      && data.version is int && data.version == 3;
  }

  // Whether the map `after` only lost entries of the same map in `before`.
  function onlyFewer(after, before) {
    return after is map && before.size() > 0 && after.size() < before.size()
      && before.keys().hasAll(after.keys())
      && after.diff(before).changedKeys().size() == 0;
  }

  // The rules know no loop: each value of a map is checked by its index, up
  // to the map's cap, `n` its size; the keys all at once, joined, as DBB
  // ids, which costs a few expressions instead of some per entry: as many
  // parts as keys, so no key holds a comma, each of at most 15 digits, so
  // within JavaScript's safe integers (DBB ids have 6 or 7).
  function areIds(entries) {
    return entries.size() == 0
      || (entries.keys().join(",").matches("[1-9][0-9]{0,14}(,[1-9][0-9]{0,14})*")
        && entries.keys().join(",").split(",").size() == entries.size());
  }

  // Meine Teams: each Team's DBB id, since when it is followed.
  function areTeams(teams) {
    return teams is map && teams.size() <= 50 && areIds(teams)
      && teamsUpTo(teams.values(), teams.size());
  }

  function teamsUpTo(since, n) {
    return (n <= 0 || since[0] is int) && (n <= 1 || since[1] is int) && (n <= 2 || since[2] is int)
      && (n <= 3 || since[3] is int) && (n <= 4 || since[4] is int) && (n <= 5 || since[5] is int)
      && (n <= 6 || since[6] is int) && (n <= 7 || since[7] is int) && (n <= 8 || since[8] is int)
      && (n <= 9 || since[9] is int) && (n <= 10 || since[10] is int) && (n <= 11 || since[11] is int)
      && (n <= 12 || since[12] is int) && (n <= 13 || since[13] is int) && (n <= 14 || since[14] is int)
      && (n <= 15 || since[15] is int) && (n <= 16 || since[16] is int) && (n <= 17 || since[17] is int)
      && (n <= 18 || since[18] is int) && (n <= 19 || since[19] is int) && (n <= 20 || since[20] is int)
      && (n <= 21 || since[21] is int) && (n <= 22 || since[22] is int) && (n <= 23 || since[23] is int)
      && (n <= 24 || since[24] is int) && (n <= 25 || since[25] is int) && (n <= 26 || since[26] is int)
      && (n <= 27 || since[27] is int) && (n <= 28 || since[28] is int) && (n <= 29 || since[29] is int)
      && (n <= 30 || since[30] is int) && (n <= 31 || since[31] is int) && (n <= 32 || since[32] is int)
      && (n <= 33 || since[33] is int) && (n <= 34 || since[34] is int) && (n <= 35 || since[35] is int)
      && (n <= 36 || since[36] is int) && (n <= 37 || since[37] is int) && (n <= 38 || since[38] is int)
      && (n <= 39 || since[39] is int) && (n <= 40 || since[40] is int) && (n <= 41 || since[41] is int)
      && (n <= 42 || since[42] is int) && (n <= 43 || since[43] is int) && (n <= 44 || since[44] is int)
      && (n <= 45 || since[45] is int) && (n <= 46 || since[46] is int) && (n <= 47 || since[47] is int)
      && (n <= 48 || since[48] is int) && (n <= 49 || since[49] is int);
  }

  // The Kinder: each one's person id, since when it is marked and its
  // Spitzname.
  function areChildren(children) {
    return children is map && children.size() <= 20 && areIds(children)
      && childrenUpTo(children.values(), children.size());
  }

  function childrenUpTo(children, n) {
    return (n <= 0 || isChild(children[0])) && (n <= 1 || isChild(children[1])) && (n <= 2 || isChild(children[2]))
      && (n <= 3 || isChild(children[3])) && (n <= 4 || isChild(children[4])) && (n <= 5 || isChild(children[5]))
      && (n <= 6 || isChild(children[6])) && (n <= 7 || isChild(children[7])) && (n <= 8 || isChild(children[8]))
      && (n <= 9 || isChild(children[9])) && (n <= 10 || isChild(children[10])) && (n <= 11 || isChild(children[11]))
      && (n <= 12 || isChild(children[12])) && (n <= 13 || isChild(children[13])) && (n <= 14 || isChild(children[14]))
      && (n <= 15 || isChild(children[15])) && (n <= 16 || isChild(children[16])) && (n <= 17 || isChild(children[17]))
      && (n <= 18 || isChild(children[18])) && (n <= 19 || isChild(children[19]));
  }

  // A Kind: since when it is marked and, optionally, the Spitzname the app
  // keeps to 30 characters (an emoji as one), here at most 330 code points
  // (SPITZNAME_CODEPUNKTE in kind.ts: 30 of the longest emoji); a regular
  // expression, as it costs fewer expressions than a type and a size check,
  // and fails on anything but text. Without `since` it is none: a Spitzname
  // written to a Kind another device unmarked meanwhile is refused, not
  // made a Kind again.
  function isChild(child) {
    return child.keys().hasOnly(["since", "nickname"]) && child.since is int
      && (child.size() == 1 || child.nickname.matches("(?s).{0,330}"));
  }

  // The Vereinsfarben: each Verein's DBB id to its colours as one text
  // (farbenText in vereinsfarben.ts): #rrggbb in lower case, a second one
  // after a comma. All values at once, joined, as the keys: a check per
  // entry costs more than a request may evaluate for 50 Vereine. As many
  // parts as values, so no value holds the joining ";", and a value that is
  // no text fails the join.
  function areClubColors(colors) {
    return colors is map && colors.size() <= 50
      && areIds(colors)
      && (colors.size() == 0 || areColorTexts(colors.values().join(";"), colors.size()));
  }

  // `texts`, the values joined, as colours: `n` of them, each #rrggbb in
  // lower case with an optional second after a comma. Bound once, as each
  // join counts as expressions again.
  function areColorTexts(texts, n) {
    return texts.matches("#[0-9a-f]{6}(,#[0-9a-f]{6})?(;#[0-9a-f]{6}(,#[0-9a-f]{6})?)*")
      && texts.split(";").size() == n;
  }
}
