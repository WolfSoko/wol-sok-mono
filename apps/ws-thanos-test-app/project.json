{
  "name": "ws-thanos-test-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ws-thanos-test-app/src",
  "prefix": "app",
  "tags": ["type:test-app", "app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/ws-thanos-test-app",
        "index": "apps/ws-thanos-test-app/src/index.html",
        "tsConfig": "apps/ws-thanos-test-app/tsconfig.app.json",
        "assets": [],
        "styles": ["apps/ws-thanos-test-app/src/styles.css"],
        "scripts": [],
        "browser": "apps/ws-thanos-test-app/src/main.ts"
      },
      "configurations": {
        "production": {
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "ws-thanos-test-app:build:production"
        },
        "development": {
          "buildTarget": "ws-thanos-test-app:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4350
      }
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "outputs": [
        "{workspaceRoot}/playwright-report",
        "{workspaceRoot}/test-results"
      ],
      "options": {
        "config": "apps/ws-thanos-test-app/playwright.config.ts"
      }
    }
  }
}
