{
  "name": "bacteria-game-remote",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/bacteria-game-remote/src",
  "prefix": "wolsok",
  "tags": ["app", "type:remote"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals", "federation"]
  },
  "targets": {
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": ["{workspaceRoot}/dist/apps/bacteria-game-remote"],
      "dependsOn": ["^build"],
      "options": {
        "outputPath": {
          "base": "dist/apps/bacteria-game-remote",
          "browser": ""
        },
        "index": "apps/bacteria-game-remote/src/index.html",
        "tsConfig": "apps/bacteria-game-remote/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/bacteria-game-remote/src/favicon.ico",
          "apps/bacteria-game-remote/src/manifest.webmanifest",
          "apps/bacteria-game-remote/src/icons",
          "apps/bacteria-game-remote/src/assets",
          {
            "glob": "assetlinks.json",
            "input": "apps/bacteria-game-remote/src/.well-known",
            "output": ".well-known"
          }
        ],
        "styles": [
          "apps/bacteria-game-remote/src/styles.scss",
          "node_modules/@angular/material/prebuilt-themes/pink-bluegrey.css"
        ],
        "scripts": [],
        "browser": "apps/bacteria-game-remote/src/main.ts",
        "polyfills": ["es-module-shims"]
      },
      "configurations": {
        "production": {
          "sourceMap": {
            "hidden": false,
            "scripts": true,
            "styles": true,
            "vendor": true
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "8kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/bacteria-game-remote/src/environments/environment.ts",
              "with": "apps/bacteria-game-remote/src/environments/environment.prod.ts"
            }
          ],
          "serviceWorker": "apps/bacteria-game-remote/ngsw-config.json",
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/bacteria-game-remote/ngsw.json"],
      "dependsOn": ["build-federation"],
      "options": {
        "command": "echo No service worker in development builds.",
        "forwardAllArgs": false
      },
      "configurations": {
        "production": {
          "command": "ngsw-config dist/apps/bacteria-game-remote apps/bacteria-game-remote/ngsw-config.json /"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "build-federation": {
      "executor": "@angular-architects/native-federation:build",
      "outputs": ["{workspaceRoot}/dist/apps/bacteria-game-remote"],
      "inputs": ["sharedGlobals", "production", "^production"],
      "dependsOn": ["^build"],
      "cache": true,
      "options": {},
      "configurations": {
        "production": {
          "target": "bacteria-game-remote:esbuild:production"
        },
        "development": {
          "target": "bacteria-game-remote:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-original": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4202
      },
      "configurations": {
        "production": {
          "buildTarget": "bacteria-game-remote:esbuild:production"
        },
        "development": {
          "buildTarget": "bacteria-game-remote:esbuild:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "bacteria-game-remote:serve-original:development",
        "rebuildDelay": 500,
        "dev": true,
        "port": 4202,
        "open": false
      },
      "continuous": true
    },
    "icons": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx ./tools/bacteria-game/generate-icons.ts"
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "bacteria-game-remote:esbuild"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/bacteria-game-remote"],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/jest.config.ts",
        "{workspaceRoot}/.codecov.yml",
        "{workspaceRoot}/apps/bacteria-game-android/app/build.gradle.kts",
        "{workspaceRoot}/apps/bacteria-game-remote-cdk/src/main.ts"
      ],
      "options": {
        "jestConfig": "apps/bacteria-game-remote/jest.config.ts",
        "codeCoverage": true,
        "tsConfig": "apps/bacteria-game-remote/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "staticFilePath": "dist/apps/bacteria-game-remote",
        "port": 4202,
        "watch": false
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    }
  }
}
