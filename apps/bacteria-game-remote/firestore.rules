rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // What the game stores for a player, a document per key
    // (FirestoreGameStorage): only the player reads and writes it - a guest
    // (anonymous) account as much as a Google one.
    match /players/{playerId}/storage/{key} {
      allow read: if isPlayer(playerId);
      allow create, update: if isPlayer(playerId) && notBanned() &&
        key.matches('bacteria-game[.][a-z-]+') &&
        isStoredValue(request.resource.data);
      allow delete: if isPlayer(playerId);
    }

    // The rooms online matches meet in (FirestoreGameRooms): the host opens
    // one under a code with its offer, one guest answers it. Anyone signed
    // in reads a room by its code - knowing the code is the invitation -
    // but nobody lists them. A TTL policy on expireAt deletes old rooms.
    match /rooms/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && notBanned() &&
        code.matches('[A-HJ-NP-Z2-9]{6}') &&
        request.resource.data.keys().hasOnly(['host', 'offer', 'createdAt', 'expireAt']) &&
        request.resource.data.host == request.auth.uid &&
        isDescription(request.resource.data.offer) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expireAt is timestamp &&
        request.resource.data.expireAt < request.time + duration.value(2, 'h');
      allow update: if request.auth != null && notBanned() && ((
          // A guest answers an open room only - never its stub, which
          // has no answer either.
          !('answer' in resource.data) && !('guest' in resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'answer']) &&
          request.resource.data.guest == request.auth.uid &&
          isDescription(request.resource.data.answer)) ||
        // Once the guest answered, the host swaps the room for its stub
        // (ADR 0011): who played, without the descriptions and their
        // addresses, kept up to 6 hours - what the functions bind an online
        // replay's players to.
        ('answer' in resource.data &&
          request.auth.uid == resource.data.host &&
          request.resource.data.keys().hasOnly(['host', 'guest', 'createdAt', 'expireAt', 'taken']) &&
          request.resource.data.host == resource.data.host &&
          request.resource.data.guest == resource.data.guest &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.taken == true &&
          request.resource.data.expireAt is timestamp &&
          request.resource.data.expireAt <= resource.data.createdAt + duration.value(6, 'h')));
      allow delete: if request.auth != null && request.auth.uid == resource.data.host;
    }

    // What other players see of a player (ADR 0010): anyone signed in reads
    // a profile, only its owner writes it.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow create, update: if isPlayer(uid) && notBanned() && isProfile(request.resource.data);
      allow delete: if isPlayer(uid);
    }

    // A declared ranked attempt (ADR 0012): written once by its player
    // before a ranked daily or endless match, at the server's time, which
    // the match seed comes from. Never changed or deleted by the client;
    // TTL takes it after 31 days.
    match /players/{owner}/attempts/{attemptId} {
      allow get, list: if isPlayer(owner);
      allow create: if isPlayer(owner) && notBanned() &&
        request.resource.data.keys().hasOnly(['at', 'expireAt']) &&
        request.resource.data.at == request.time &&
        expiresWithin(request.resource.data.expireAt, duration.value(32, 'd')) &&
        ((attemptId.matches('d_[0-9]{4}-[0-9]{2}-[0-9]{2}_[1-3]') &&
          isDailyAttempt(owner, attemptId)) ||
         (attemptId.matches('e_[0-9]{8}[1-5]_(0|[1-9][0-9]{0,2})') &&
          isEndlessAttempt(owner, attemptId)));
    }

    // A player's friends, each side writing its own list - or the inviter's,
    // with the token of an invitation the inviter made. A player may see
    // whether someone lists them, and take themselves off a list.
    match /players/{owner}/friends/{friend} {
      allow get: if isPlayer(owner) || isPlayer(friend);
      allow list: if isPlayer(owner);
      // Update too: asking or accepting again rewrites an existing entry.
      allow create, update: if owner != friend && notBanned() &&
        request.resource.data.since == request.time &&
        ((isPlayer(owner) && request.resource.data.keys().hasOnly(['since'])) ||
         (isPlayer(friend) &&
          request.resource.data.keys().hasOnly(['since', 'invite']) &&
          request.resource.data.invite is string &&
          get(/databases/$(database)/documents/invites/$(request.resource.data.invite)).data.from == owner));
      allow delete: if isPlayer(owner) || isPlayer(friend);
    }

    // Asks to be friends, left by the one asking.
    match /players/{owner}/requests/{from} {
      allow get: if isPlayer(owner) || isPlayer(from);
      allow list: if isPlayer(owner);
      allow create, update: if isPlayer(from) && from != owner && notBanned() &&
        request.resource.data.keys().hasOnly(['at']) &&
        request.resource.data.at == request.time;
      allow delete: if isPlayer(owner) || isPlayer(from);
    }

    // A friend's challenge to the match in a room - only from someone the
    // challenged player lists as a friend.
    match /players/{owner}/challenges/{from} {
      allow get: if isPlayer(owner) || isPlayer(from);
      allow list: if isPlayer(owner);
      allow create, update: if isPlayer(from) && notBanned() &&
        exists(/databases/$(database)/documents/players/$(owner)/friends/$(from)) &&
        request.resource.data.keys().hasOnly(['code', 'at', 'expireAt']) &&
        isRoomCode(request.resource.data.code) &&
        request.resource.data.at == request.time &&
        expiresWithin(request.resource.data.expireAt, duration.value(1, 'h'));
      allow delete: if isPlayer(owner) || isPlayer(from);
    }

    // An invitation link to become friends, for a week.
    match /invites/{token} {
      allow get: if signedIn();
      allow create: if signedIn() && notBanned() && token.matches('[a-z2-9]{20}') &&
        request.resource.data.keys().hasOnly(['from', 'at', 'expireAt']) &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.at == request.time &&
        expiresWithin(request.resource.data.expireAt, duration.value(8, 'd'));
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // The matchmaking queue: a player's entry, with the level they would
    // like (null for any), which a newer player may claim once by writing
    // a room's code into it - and the level it picked, and whose choice
    // that was (ADR 0012; an older claimer writes neither).
    match /queue/{uid} {
      allow read: if signedIn();
      allow create: if isPlayer(uid) && notBanned() &&
        request.resource.data.keys().hasOnly(['since', 'seen', 'expireAt', 'level', 'claim']) &&
        request.resource.data.since == request.time &&
        request.resource.data.seen == request.time &&
        request.resource.data.claim == null &&
        isQueueLevel(request.resource.data.get('level', null)) &&
        expiresWithin(request.resource.data.expireAt, duration.value(1, 'h'));
      allow update: if notBanned() && ((isPlayer(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'expireAt', 'level']) &&
          request.resource.data.seen == request.time &&
          isQueueLevel(request.resource.data.get('level', null)) &&
          expiresWithin(request.resource.data.expireAt, duration.value(1, 'h'))) ||
        (signedIn() && request.auth.uid != uid &&
          resource.data.claim == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claim']) &&
          request.resource.data.claim.keys().hasOnly(['by', 'code', 'level', 'pick']) &&
          request.resource.data.claim.by == request.auth.uid &&
          isRoomCode(request.resource.data.claim.code) &&
          isQueueLevel(request.resource.data.claim.get('level', null)) &&
          request.resource.data.claim.get('pick', 'waiting') in ['waiting', 'claimer', 'random']));
      allow delete: if isPlayer(uid);
    }

    // A recorded match for the functions to keep (ADR 0011, 0012): written
    // once by its player, read by nobody - acceptReplay turns it into
    // replays/{id} and deletes it, and TTL takes what a failed function
    // left behind.
    match /replaySubmissions/{id} {
      allow create: if signedIn() && notBanned() &&
        request.resource.data.keys().hasOnly(['uid', 'bytes', 'hint', 'createdAt', 'expireAt', 'attempt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.bytes is bytes &&
        request.resource.data.bytes.size() <= 600000 &&
        request.resource.data.hint is int &&
        request.resource.data.hint >= 0 && request.resource.data.hint <= 100 &&
        request.resource.data.createdAt == request.time &&
        isCommandExpiry(request.resource.data.expireAt) &&
        (!('attempt' in request.resource.data) ||
          (request.resource.data.attempt is string &&
           exists(/databases/$(database)/documents/players/$(request.auth.uid)/attempts/$(request.resource.data.attempt))));
    }

    // A command on a stored replay: `remove` by any player, the gallery's
    // types only by the owner. The writer reads it back for the result the
    // function writes on it.
    match /replayCommands/{id} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && notBanned() &&
        request.resource.data.keys().hasOnly(['uid', 'type', 'replayId', 'createdAt', 'expireAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.replayId is string &&
        request.resource.data.replayId.matches('[A-Za-z0-9_-]{1,64}') &&
        request.resource.data.createdAt == request.time &&
        isCommandExpiry(request.resource.data.expireAt) &&
        (request.resource.data.type == 'remove' ||
          (request.resource.data.type in ['feature', 'unfeature', 'anonymise'] && isAdmin()));
    }

    // Stored replays, written by the functions only: a player reads those
    // they played, a page of 50 at most, and the bytes one at a time.
    match /replays/{id} {
      allow get: if signedIn() && request.auth.uid in resource.data.players;
      allow list: if signedIn() && request.auth.uid in resource.data.players &&
        request.query.limit <= 50;

      match /blob/{doc} {
        allow get: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/replays/$(id)).data.players;
      }
    }

    // The leaderboards (ADR 0012), written by the functions only. Anyone
    // signed in reads a board's top document and pages its entries - never
    // a hidden one, which only the owner sees.
    match /boards/{boardId} {
      allow get: if signedIn();

      match /entries/{entryId} {
        allow get: if signedIn() && (resource.data.status != 'hidden' || isAdmin());
        allow list: if signedIn() &&
          (resource.data.status in ['counted', 'verified', 'provisional', 'stale'] || isAdmin());
      }
    }

    // Which entries are a player's, and what the boards counted of them:
    // only the player and the owner read it.
    match /boardMembers/{uid} {
      allow get: if isPlayer(uid) || isAdmin();
    }

    // A ban (ADR 0012), written by the functions only: the player may read
    // their own, to show why and until when.
    match /bans/{uid} {
      allow get: if isPlayer(uid) || isAdmin();
    }

    function signedIn() {
      return request.auth != null;
    }

    // The owner (ADR 0011): the admin claim, on a verified Google account.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.get('admin', false) == true &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // No ban holds for the writer (ADR 0012): there is none, or it ended -
    // inclusive, like the functions' check. Every client write asks it;
    // deletes stay allowed, so a banned player can still erase their data.
    function notBanned() {
      let ban = /databases/$(database)/documents/bans/$(request.auth.uid);
      return !exists(ban) ||
        (get(ban).data.until != null && get(ban).data.until <= request.time);
    }

    // A command document's end: about a day ahead by the client's clock,
    // which TTL then honours.
    function isCommandExpiry(expireAt) {
      return expireAt is timestamp && expireAt > request.time &&
        expireAt < request.time + duration.value(2, 'd');
    }

    function isQueueLevel(level) {
      return level == null || (level is string && level.matches('^[a-z0-9-]{1,40}$'));
    }

    function isRoomCode(code) {
      return code is string && code.matches('[A-HJ-NP-Z2-9]{6}');
    }

    function expiresWithin(expireAt, span) {
      return expireAt is timestamp && expireAt < request.time + span;
    }

    function isProfile(data) {
      return data.keys().hasOnly(['name', 'motto', 'avatar', 'shareStatus', 'updatedAt', 'publicName', 'galleryOptOut', 'boardOptOut']) &&
        data.get('publicName', false) is bool &&
        data.get('galleryOptOut', false) is bool &&
        data.get('boardOptOut', false) is bool &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 24 &&
        data.motto is string && data.motto.size() <= 80 &&
        data.shareStatus is bool &&
        data.updatedAt == request.time &&
        isAvatar(data.avatar);
    }

    // A drawn bacterium, the URL of a Google account's photo, or a small
    // uploaded image.
    function isAvatar(avatar) {
      return avatar is map && (
        (avatar.kind == 'preset' && avatar.keys().hasOnly(['kind', 'id']) &&
          avatar.id is int && avatar.id >= 0 && avatar.id < 12) ||
        (avatar.kind == 'photo' && avatar.keys().hasOnly(['kind', 'url']) &&
          avatar.url is string && avatar.url.size() <= 500 &&
          avatar.url.matches('https://lh[0-9]+[.]googleusercontent[.]com/.+')) ||
        (avatar.kind == 'image' && avatar.keys().hasOnly(['kind', 'data']) &&
          avatar.data is string && avatar.data.size() <= 40000 &&
          avatar.data.matches('data:image/(webp|png|jpeg);base64,[A-Za-z0-9+/=]+')));
    }

    // A WebRTC session description, with its candidates.
    function isDescription(value) {
      return value is string && value.size() <= 20000;
    }

    // `d_YYYY-MM-DD_n`: today's (UTC), and attempt n - 1 came first.
    function isDailyAttempt(owner, id) {
      let parts = id.split('_');
      let day = parts[1].split('-');
      let n = int(parts[2]);
      return isToday(day[0], day[1], day[2]) &&
        (n == 1 || hasAttempt(owner, 'd_' + parts[1] + '_' + string(n - 1)));
    }

    // `e_<YYYYMMDDr>_i`: match i - 1 of the run came first; match 0 starts
    // run r today (UTC), after run r - 1 of the day. Later matches may go
    // on past midnight.
    function isEndlessAttempt(owner, id) {
      let parts = id.split('_');
      let run = parts[1];
      let r = int(run[8:9]);
      let i = int(parts[2]);
      return i > 0
        ? hasAttempt(owner, 'e_' + run + '_' + string(i - 1))
        : isToday(run[0:4], run[4:6], run[6:8]) &&
          (r == 1 || hasAttempt(owner, 'e_' + run[0:8] + string(r - 1) + '_0'));
    }

    function hasAttempt(owner, id) {
      return exists(/databases/$(database)/documents/players/$(owner)/attempts/$(id));
    }

    function isToday(year, month, day) {
      return int(year) == request.time.year() &&
        int(month) == request.time.month() &&
        int(day) == request.time.day();
    }

    function isPlayer(playerId) {
      return request.auth != null && request.auth.uid == playerId;
    }

    // The value as JSON, kept well below the document limit of 1 MiB.
    function isStoredValue(data) {
      return data.keys().hasOnly(['json', 'updatedAt']) &&
        data.json is string &&
        data.json.size() <= 200000 &&
        data.updatedAt == request.time;
    }
  }
}
