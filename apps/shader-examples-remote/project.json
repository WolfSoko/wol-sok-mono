{
  "name": "shader-examples-remote",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/shader-examples-remote/src",
  "tags": ["app", "type:remote", "scope:shader-examples"],
  "targets": {
    "esbuild": {
      "executor": "@angular/build:application",
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/apps/shader-examples-remote"],
      "options": {
        "outputPath": {
          "base": "dist/apps/shader-examples-remote",
          "browser": ""
        },
        "index": "apps/shader-examples-remote/src/index.html",
        "tsConfig": "apps/shader-examples-remote/tsconfig.app.json",
        "assets": [
          "apps/shader-examples-remote/src/favicon.ico",
          "apps/shader-examples-remote/src/assets"
        ],
        "styles": [
          "apps/shader-examples-remote/src/styles.scss",
          "node_modules/@angular/material/prebuilt-themes/pink-bluegrey.css"
        ],
        "scripts": [],
        "browser": "apps/shader-examples-remote/src/main.ts",
        "polyfills": ["es-module-shims"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "outputs": ["{workspaceRoot}/dist/apps/shader-examples-remote"],
      "dependsOn": ["^build"],
      "options": {},
      "configurations": {
        "production": {
          "target": "shader-examples-remote:esbuild:production"
        },
        "development": {
          "target": "shader-examples-remote:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-original": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4203
      },
      "configurations": {
        "production": {
          "buildTarget": "shader-examples-remote:esbuild:production"
        },
        "development": {
          "buildTarget": "shader-examples-remote:esbuild:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "shader-examples-remote:serve-original:development",
        "rebuildDelay": 500,
        "dev": true,
        "port": 4203,
        "open": false
      },
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "shader-examples-remote:build"
      }
    },
    "lint": {
      "options": {
        "args": ["./**/*.ts", "./**/*.html"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/shader-examples-remote/jest.config.ts",
        "tsConfig": "apps/shader-examples-remote/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "shader-examples-remote:build",
        "port": 4203,
        "watch": false
      },
      "configurations": {
        "development": {
          "buildTarget": "shader-examples-remote:build:development"
        },
        "production": {
          "buildTarget": "shader-examples-remote:build:production"
        }
      }
    }
  }
}
