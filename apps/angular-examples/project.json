{
  "name": "angular-examples",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/angular-examples/src",
  "prefix": "app",
  "tags": ["app", "type:host"],
  "targets": {
    "generate-version": {
      "executor": "nx:run-commands",
      "inputs": [
        "cdk-deployed-version",
        "{workspaceRoot}/tools/version-handling/**/*",
        "{workspaceRoot}/version.json"
      ],
      "outputs": ["{projectRoot}/src/environments/version-tag.generated.ts"],
      "cache": true,
      "options": {
        "command": "tsx ./tools/version-handling/write-version-tag.ts cdk-deployed apps/angular-examples/src/environments/version-tag.generated.ts"
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "inputs": [
        "production",
        "sharedGlobals",
        "^production",
        "cdk-deployed-version"
      ],
      "dependsOn": ["^build", "generate-version"],
      "outputs": ["{workspaceRoot}/dist/apps/angular-examples"],
      "options": {
        "outputPath": {
          "base": "dist/apps/angular-examples",
          "browser": ""
        },
        "index": "apps/angular-examples/src/index.html",
        "tsConfig": "apps/angular-examples/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "*.*",
            "input": "dist/libs/fib-wasm/",
            "output": "fib-wasm"
          },
          "apps/angular-examples/src/favicon.ico",
          "apps/angular-examples/src/manifest.json",
          "apps/angular-examples/src/assets"
        ],
        "styles": ["apps/angular-examples/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": [
            "apps/angular-examples/src/styles",
            "libs/ui-kit/src/lib/styles"
          ]
        },
        "allowedCommonJsDependencies": [],
        "sourceMap": true,
        "browser": "apps/angular-examples/src/main.ts",
        "polyfills": ["es-module-shims"]
      },
      "configurations": {
        "production": {
          "sourceMap": {
            "hidden": false,
            "scripts": true,
            "styles": true,
            "vendor": true
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2.48mb",
              "maximumError": "2.9mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/angular-examples/src/environments/environment.ts",
              "with": "apps/angular-examples/src/environments/environment.prod.ts"
            }
          ],
          "serviceWorker": "apps/angular-examples/ngsw-config.json",
          "outputHashing": "all"
        },
        "development": {
          "preserveSymlinks": true,
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "outputs": ["{workspaceRoot}/dist/apps/angular-examples"],
      "dependsOn": ["^build", "generate-version"],
      "options": {},
      "configurations": {
        "production": {
          "target": "angular-examples:esbuild:production"
        },
        "development": {
          "target": "angular-examples:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-original": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4200
      },
      "configurations": {
        "production": {
          "buildTarget": "angular-examples:esbuild:production"
        },
        "development": {
          "buildTarget": "angular-examples:esbuild:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "angular-examples:serve-original:development",
        "rebuildDelay": 500,
        "dev": true,
        "port": 4200,
        "open": false
      },
      "continuous": true
    },
    "serve-all": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx run-many -t serve -p angular-examples fourier-analysis-remote bacteria-game-remote shader-examples-remote"
        ]
      },
      "continuous": true
    },
    "serve-file": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "angular-examples:build",
        "spa": true
      },
      "configurations": {
        "production": {
          "buildTarget": "angular-examples:build:production"
        },
        "development": {
          "buildTarget": "angular-examples:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "angular-examples:build"
      }
    },
    "lint": {
      "options": {
        "args": ["./**/*.ts", "./**/*.html"]
      },
      "dependsOn": ["generate-version"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/angular-examples"],
      "options": {
        "jestConfig": "apps/angular-examples/jest.config.ts",
        "passWithNoTests": false,
        "codeCoverage": true,
        "tsConfig": "apps/angular-examples/tsconfig.spec.json"
      },
      "dependsOn": ["generate-version"]
    }
  }
}
