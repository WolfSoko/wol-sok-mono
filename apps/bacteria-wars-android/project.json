{
  "name": "bacteria-wars-android",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["type:android"],
  "targets": {
    "apk": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bacteria-wars-android",
        "command": "./gradlew assembleDebug"
      },
      "configurations": {
        "release": {
          "command": "./gradlew assembleRelease"
        }
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bacteria-wars-android",
        "command": "./gradlew bundleRelease"
      }
    },
    "lint-android": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/bacteria-wars-android",
        "command": "./gradlew lintDebug"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "inputs": [
        "production",
        "{workspaceRoot}/apps/bacteria-game-remote/src/.well-known/assetlinks.json",
        "{workspaceRoot}/libs/features/bacteria-engine/src/lib/state/progress/play-games-achievements.json",
        "{workspaceRoot}/tools/bacteria-game/deploy-android.ts",
        "{workspaceRoot}/tools/bacteria-game/play-games.ts",
        "{workspaceRoot}/tools/bacteria-game/play-tips.ts",
        "{workspaceRoot}/tools/youtube/youtube.ts",
        "{workspaceRoot}/libs/utils/version/src/index.ts",
        "{workspaceRoot}/libs/utils/version/src/version.ts"
      ],
      "options": {
        "command": "tsx --tsconfig tools/tsconfig.tools.json ./tools/bacteria-game/deploy-android.ts"
      }
    },
    "store-assets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx ./tools/bacteria-game/generate-store-assets.ts"
      }
    },
    "achievement-icons": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig tools/tsconfig.tools.json ./tools/bacteria-game/generate-achievement-icons.ts"
      }
    },
    "promo-video": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx ./tools/bacteria-game/promo-video/make.ts"
      }
    },
    "promo-short": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx ./tools/bacteria-game/promo-video/short/short.ts"
      }
    }
  }
}
