{
  "name": "fourier-analysis-remote",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/fourier-analysis-remote/src",
  "prefix": "wolsok",
  "tags": ["app", "type:remote"],
  "targets": {
    "esbuild": {
      "dependsOn": ["^build"],
      "executor": "@angular/build:application",
      "outputs": ["{workspaceRoot}/dist/apps/fourier-analysis-remote"],
      "options": {
        "outputPath": {
          "base": "dist/apps/fourier-analysis-remote",
          "browser": ""
        },
        "index": "apps/fourier-analysis-remote/src/index.html",
        "tsConfig": "apps/fourier-analysis-remote/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/fourier-analysis-remote/src/favicon.ico",
          "apps/fourier-analysis-remote/src/assets"
        ],
        "styles": [
          "apps/fourier-analysis-remote/src/styles.scss",
          "node_modules/@angular/material/prebuilt-themes/pink-bluegrey.css"
        ],
        "scripts": [],
        "browser": "apps/fourier-analysis-remote/src/main.ts",
        "polyfills": ["es-module-shims"]
      },
      "configurations": {
        "production": {
          "sourceMap": {
            "hidden": false,
            "scripts": true,
            "styles": true,
            "vendor": true
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/fourier-analysis-remote/src/environments/environment.ts",
              "with": "apps/fourier-analysis-remote/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "outputs": ["{workspaceRoot}/dist/apps/fourier-analysis-remote"],
      "dependsOn": ["^build"],
      "options": {},
      "configurations": {
        "production": {
          "target": "fourier-analysis-remote:esbuild:production"
        },
        "development": {
          "target": "fourier-analysis-remote:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-original": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "fourier-analysis-remote:esbuild:production"
        },
        "development": {
          "buildTarget": "fourier-analysis-remote:esbuild:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "fourier-analysis-remote:serve-original:development",
        "rebuildDelay": 500,
        "dev": true,
        "port": 4201,
        "open": false
      },
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "fourier-analysis-remote:build"
      }
    },
    "lint": {
      "options": {
        "args": ["./**/*.ts", "./**/*.html"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/fourier-analysis-remote"],
      "options": {
        "jestConfig": "apps/fourier-analysis-remote/jest.config.ts",
        "codeCoverage": true,
        "tsConfig": "apps/fourier-analysis-remote/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "fourier-analysis-remote:build",
        "port": 4201
      },
      "configurations": {
        "development": {
          "buildTarget": "fourier-analysis-remote:build:development"
        },
        "production": {
          "buildTarget": "fourier-analysis-remote:build:production"
        }
      }
    }
  }
}
