{
  "endless runs of a player by score": {
    "usedBy": "saveRun: a player's best endless run",
    "group": "endlessRuns",
    "fields": [
      {
        "fieldPath": "uid",
        "order": "ASCENDING"
      },
      {
        "fieldPath": "sort",
        "order": "DESCENDING"
      }
    ]
  },
  "visible entries in board order": {
    "usedBy": "rebuildTop and the verification's candidates - and the game's board pages and a player's own rank (count())",
    "group": "entries",
    "fields": [
      {
        "fieldPath": "status",
        "order": "ASCENDING"
      },
      {
        "fieldPath": "sort",
        "order": "DESCENDING"
      },
      {
        "fieldPath": "atHour",
        "order": "ASCENDING"
      }
    ]
  },
  "taken rooms still open": {
    "usedBy": "computeStats: the matches running (count())",
    "group": "rooms",
    "fields": [
      {
        "fieldPath": "taken",
        "order": "ASCENDING"
      },
      {
        "fieldPath": "expireAt",
        "order": "ASCENDING"
      }
    ]
  },
  "a day's replays by state": {
    "usedBy": "featureBest: the previous day's gallery candidates",
    "group": "replays",
    "fields": [
      {
        "fieldPath": "state",
        "order": "ASCENDING"
      },
      {
        "fieldPath": "createdAt",
        "order": "ASCENDING"
      }
    ]
  },
  "public replays still up, newest first": {
    "usedBy": "publicSite: the gallery, its JSON and the replays' sitemap",
    "group": "publicReplays",
    "fields": [
      {
        "fieldPath": "removedAt",
        "order": "ASCENDING"
      },
      {
        "fieldPath": "featuredAt",
        "order": "DESCENDING"
      }
    ]
  }
}
