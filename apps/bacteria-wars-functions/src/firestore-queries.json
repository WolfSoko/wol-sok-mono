{
  "replays by state and age": {
    "usedBy": "the hourly \"Not reported\" sweep (closeNotReported)",
    "group": "replays",
    "fields": [
      { "fieldPath": "state", "order": "ASCENDING" },
      { "fieldPath": "createdAt", "order": "ASCENDING" }
    ]
  },
  "visible entries in board order": {
    "usedBy": "rebuildTop and the verification's candidates - and the game's board pages and a player's own rank (count())",
    "group": "entries",
    "fields": [
      { "fieldPath": "status", "order": "ASCENDING" },
      { "fieldPath": "sort", "order": "DESCENDING" },
      { "fieldPath": "atHour", "order": "ASCENDING" }
    ]
  }
}
