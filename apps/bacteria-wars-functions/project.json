{
  "name": "bacteria-wars-functions",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/bacteria-wars-functions/src",
  "tags": ["app", "type:firebase", "type:functions"],
  "implicitDependencies": ["bacteria-game-remote"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "dependsOn": [],
      "options": {
        "main": "apps/bacteria-wars-functions/src/main.ts",
        "outputPath": "dist/apps/bacteria-wars-functions",
        "tsConfig": "apps/bacteria-wars-functions/tsconfig.app.json",
        "platform": "node",
        "target": "node22",
        "format": ["esm"],
        "bundle": true,
        "thirdParty": true,
        "generatePackageJson": true,
        "sourcemap": true,
        "esbuildOptions": {
          "splitting": true,
          "chunkNames": "chunks/[name]-[hash]",
          "external": ["firebase-functions", "firebase-admin"]
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.js",
        "{workspaceRoot}/jest.config.ts",
        "{workspaceRoot}/.codecov.yml",
        "{workspaceRoot}/apps/bacteria-game-remote/firestore.indexes.json",
        "{workspaceRoot}/firebase.bacteria-game-remote.json"
      ],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/bacteria-wars-functions/jest.config.ts",
        "tsConfig": "apps/bacteria-wars-functions/tsconfig.spec.json"
      }
    },
    "test-rules": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/bacteria-game-remote/firestore.rules",
        "{workspaceRoot}/apps/bacteria-game-remote/database.rules.json"
      ],
      "options": {
        "command": "firebase emulators:exec --only firestore,database --project demo-bacteria-wars --config apps/bacteria-wars-functions/firebase.rules-test.json \"npx jest -c apps/bacteria-wars-functions/jest.rules.config.ts\"",
        "forwardAllArgs": false
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "firebase emulators:exec --only firestore --project demo-bacteria-wars --config apps/bacteria-wars-functions/firebase.integration-test.json \"npx jest -c apps/bacteria-wars-functions/jest.integration.config.ts\"",
        "forwardAllArgs": false
      }
    },
    "benchmark": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx --tsconfig apps/bacteria-wars-functions/tsconfig.app.json apps/bacteria-wars-functions/src/benchmark/rerun-benchmark.ts"
      }
    },
    "emulators": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "continuous": true,
      "options": {
        "command": "firebase emulators:start --only auth,firestore,database,functions --project demo-bacteria-wars --config firebase.bacteria-game-remote.json"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "firebase deploy --only functions:bacteria --config firebase.bacteria-game-remote.json --project bacteria-game-remote"
      }
    }
  }
}
