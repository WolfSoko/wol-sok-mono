{
  "name": "feat-shared-bacteria-engine",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/features/bacteria-engine/src",
  "projectType": "library",
  "tags": ["feat-shared"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/libs/features/bacteria-engine"],
      "options": {
        "project": "libs/features/bacteria-engine/ng-package.json",
        "tsConfig": "libs/features/bacteria-engine/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/features/bacteria-engine/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/jest.preset.cjs",
        "{workspaceRoot}/jest.config.ts",
        "{workspaceRoot}/tools/perf/engine-bench.json",
        "{workspaceRoot}/tools/perf/engine-bench.mjs"
      ],
      "outputs": ["{workspaceRoot}/coverage/libs/features/bacteria-engine"],
      "options": {
        "jestConfig": "libs/features/bacteria-engine/jest.config.ts",
        "codeCoverage": true,
        "tsConfig": "libs/features/bacteria-engine/tsconfig.spec.json"
      }
    },
    "balance-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tools/bacteria-game/balance/**/*",
        "{workspaceRoot}/tools/tsconfig.tools.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "options": {
        "command": "tsx --tsconfig tools/tsconfig.tools.json ./tools/bacteria-game/balance/run.ts check"
      }
    },
    "balance": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/balance"],
      "options": {
        "command": "tsx --tsconfig tools/tsconfig.tools.json ./tools/bacteria-game/balance/run.ts full"
      }
    },
    "perf": {
      "executor": "nx:run-commands",
      "cache": true,
      "parallelism": false,
      "inputs": [
        "{projectRoot}/src/index.ts",
        "{projectRoot}/src/lib/i18n/**/*",
        "{projectRoot}/src/lib/site/**/*",
        "{projectRoot}/src/lib/social/**/*",
        "{projectRoot}/src/lib/state/*.ts",
        "{projectRoot}/src/lib/state/simulation/**/*",
        "{projectRoot}/src/lib/state/match/**/*",
        "{projectRoot}/src/lib/state/levels/**/*",
        "{projectRoot}/src/lib/state/progress/**/*",
        "{projectRoot}/src/lib/state/replay/**/*",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/package.json",
        "!{projectRoot}/**/*.spec.ts",
        "^production",
        "{workspaceRoot}/tools/perf/engine-bench.mjs",
        "{workspaceRoot}/tools/perf/engine-bench.json",
        "{workspaceRoot}/tools/perf/engine-baseline.json",
        "{workspaceRoot}/tools/perf/fixtures/**/*",
        "{workspaceRoot}/.nvmrc"
      ],
      "options": {
        "command": "node --expose-gc tools/perf/engine-bench.mjs --report-only"
      }
    }
  }
}
