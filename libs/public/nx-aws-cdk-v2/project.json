{
  "name": "nx-aws-cdk-v2",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/public/nx-aws-cdk-v2/src",
  "projectType": "library",
  "tags": ["infra-shared", "published"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/public/nx-aws-cdk-v2",
        "main": "libs/public/nx-aws-cdk-v2/src/index.ts",
        "tsConfig": "libs/public/nx-aws-cdk-v2/tsconfig.lib.json",
        "assets": [
          "libs/public/nx-aws-cdk-v2/*.md",
          {
            "input": "./libs/public/nx-aws-cdk-v2/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./libs/public/nx-aws-cdk-v2/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./libs/public/nx-aws-cdk-v2",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./libs/public/nx-aws-cdk-v2",
            "glob": "executors.json",
            "output": "."
          },
          {
            "input": "./libs/public/nx-aws-cdk-v2",
            "glob": "migrations.json",
            "output": "."
          },
          {
            "input": ".",
            "glob": "LICENSE",
            "output": "."
          }
        ]
      }
    },
    "lint": {
      "options": {
        "args": [
          "**/*.ts",
          "generators.json",
          "executors.json",
          "migrations.json",
          "package.json"
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/public/nx-aws-cdk-v2"],
      "options": {
        "jestConfig": "libs/public/nx-aws-cdk-v2/jest.config.ts",
        "passWithNoTests": false
      }
    }
  }
}
