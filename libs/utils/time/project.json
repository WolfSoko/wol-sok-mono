{
  "name": "utils-time",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/utils/time/src",
  "projectType": "library",
  "tags": ["utils"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/utils/time",
        "main": "libs/utils/time/src/index.ts",
        "tsConfig": "libs/utils/time/tsconfig.lib.json",
        "assets": ["libs/utils/time/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/utils/time/jest.config.ts"
      }
    }
  }
}
