{
  "name": "utils-version",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/utils/version/src",
  "projectType": "library",
  "tags": ["utils", "infra-shared"],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals", "workspaceVersion"],
    "workspaceVersion": ["{workspaceRoot}/version.json"]
  },
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/utils/version/jest.config.ts"
      }
    }
  }
}
